generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SALES
  VIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum CustomerStage {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

enum CustomerSource {
  WEBSITE
  MANUAL
  EMAIL
  REFERRAL
  OTHER
}

enum InquiryStatus {
  NEW
  ASSIGNED
  REPLIED
  CLOSED
}

enum InquirySource {
  WEBSITE
  EMAIL
  MANUAL
  OTHER
}

enum InquiryPriority {
  HIGH
  MEDIUM
  LOW
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL_NOTE
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id                String      @id @default(uuid()) @db.Uuid
  name              String
  email             String      @unique
  passwordHash      String
  role              UserRole
  status            UserStatus  @default(ACTIVE)
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  sessions          Session[]
  ownedCustomers    Customer[]  @relation("CustomerOwner")
  ownedInquiries    Inquiry[]   @relation("InquiryOwner")
  authoredMessages  InquiryMessage[]
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Customer {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  stage     CustomerStage  @default(NEW)
  source    CustomerSource @default(MANUAL)
  country   String?
  website   String?
  note      String?
  ownerId   String?        @db.Uuid
  deletedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  owner     User?          @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts  Contact[]
  inquiries Inquiry[]

  @@index([ownerId])
  @@index([stage])
  @@index([deletedAt])
}

model Contact {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @db.Uuid
  name       String
  email      String?
  phone      String?
  isPrimary  Boolean   @default(false)
  note       String?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  inquiries  Inquiry[]

  @@index([customerId])
  @@index([email])
  @@index([deletedAt])
}

model Inquiry {
  id         String          @id @default(uuid()) @db.Uuid
  customerId String?         @db.Uuid
  contactId  String?         @db.Uuid
  productId  String?         @db.Uuid
  subject    String
  status     InquiryStatus   @default(NEW)
  source     InquirySource   @default(WEBSITE)
  priority   InquiryPriority @default(MEDIUM)
  message    String
  ownerId    String?         @db.Uuid
  receivedAt DateTime        @default(now())
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  customer   Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contact    Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  product    Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  owner      User?           @relation("InquiryOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  messages   InquiryMessage[]

  @@index([customerId])
  @@index([contactId])
  @@index([productId])
  @@index([ownerId])
  @@index([status])
  @@index([receivedAt])
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  categoryId  String?       @db.Uuid
  name        String
  slug        String        @unique
  sku         String?
  summary     String?
  description String?
  detailHtml  String?
  priceNote   String?
  status      ProductStatus @default(DRAFT)
  coverImage  String?
  gallery     String[]      @default([])
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category    ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inquiries   Inquiry[]
  variants    ProductVariant[]

  @@index([categoryId])
  @@index([status])
  @@index([sortOrder])
}

model ProductCategory {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products  Product[]

  @@index([sortOrder])
}

model ProductVariant {
  id        String             @id @default(uuid()) @db.Uuid
  productId String             @db.Uuid
  name      String
  sku       String?
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceTiers ProductPriceTier[]

  @@index([productId])
  @@index([sku])
  @@index([sortOrder])
}

model ProductPriceTier {
  id          String         @id @default(uuid()) @db.Uuid
  variantId   String         @db.Uuid
  minQuantity Int
  maxQuantity Int?
  unitPrice   Decimal        @db.Decimal(12, 2)
  currency    String         @default("USD")
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([sortOrder])
}

model InquiryMessage {
  id        String           @id @default(uuid()) @db.Uuid
  inquiryId String           @db.Uuid
  direction MessageDirection
  body      String
  authorId  String?          @db.Uuid
  createdAt DateTime         @default(now())

  inquiry   Inquiry          @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  author    User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([inquiryId])
  @@index([authorId])
  @@index([createdAt])
}
